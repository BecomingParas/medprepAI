# Local PostgreSQL from compose.yaml (development only)
DATABASE_URL="postgresql://devuser:devpassword@localhost:5433/saas_project?schema=public"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://localhost:8081,http://127.0.0.1:8081"
# Optional override; the frontend defaults to this local GraphQL endpoint.
# NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3333/graphql"

# Better Auth session signing secret; replace this example before deployment.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google OAuth. Configure the localhost callback URL in Google Cloud:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only AI integration. Never prefix this secret with NEXT_PUBLIC_.
LOVABLE_API_KEY=
