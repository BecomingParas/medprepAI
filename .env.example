# Local PostgreSQL from compose.yaml (development only)
DATABASE_URL="postgresql://devuser:devpassword@localhost:5433/saas_project?schema=public"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://localhost:8081,http://127.0.0.1:8081"
# Optional override; the UI defaults to this local GraphQL endpoint.
# NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3333/graphql"

# Browser-visible Supabase project configuration (publishable key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only integrations. Never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
